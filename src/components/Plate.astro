---
// Notebook cover art for stories without an image. One of ten patterns in one
// of eight colours, chosen by the story's id. The figure always fits whole
// inside the card; hovering the card traces it again and sets it turning.
import type { Item } from '../lib/feed';
import { pattern, W, H } from '../lib/patterns';
interface Props { item: Item }
const { item } = Astro.props;
const p = pattern(item.id);
---
<div class={`pat pc${p.color}`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    <g class="spin">
      <path class={p.dots ? 'curve dots' : 'curve'} d={p.d} pathLength="1" />
    </g>
    <circle class="dot" cx={W / 2} cy={H / 2} r="1.8" />
  </svg>
  <span class="fig">Fig. {p.fig} — {p.name}</span>
</div>
