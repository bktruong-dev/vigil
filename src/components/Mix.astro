---
// Perspective mix: who is speaking in a set of stories. Our "measure of bias".
import { type Item, perspectiveMix, PERSPECTIVES } from '../lib/feed';
interface Props { list: Item[]; label?: string }
const { list, label = 'Perspective mix' } = Astro.props;
const mix = perspectiveMix(list);
const COLORS: Record<string, string> = { company: '#d9b878', journalism: '#86a8ff', research: '#b79cff', nonprofit: '#8fd3a8', creator: '#f2a6c4', database: '#c9c6bf' };
let x = 0;
const segs = mix.map(m => { const w = (m.n / Math.max(1, list.length)) * 100; const s = { ...m, x, w }; x += w; return s; });
---
<figure class="mix">
  <figcaption class="label"><span>{label}</span> <a href="/sources#perspective">What is this?</a></figcaption>
  <svg viewBox="0 0 100 4" preserveAspectRatio="none" role="img" aria-label={mix.map(m => `${PERSPECTIVES[m.p].label} ${m.pct}%`).join(', ')}>
    {segs.map(s => <rect x={s.x} y="0" width={Math.max(0, s.w - 0.4)} height="4" rx="0.6" fill={COLORS[s.p]} />)}
  </svg>
  <ul>
    {mix.map(m => <li><span class={`sw pc-${m.p}`}></span>{PERSPECTIVES[m.p].label} <b>{m.pct}%</b></li>)}
  </ul>
</figure>

<style>
  .mix { margin: 0; }
  figcaption { display: flex; gap: 12px; align-items: baseline; margin-bottom: 8px; }
  figcaption a { color: var(--acc); text-decoration: none; letter-spacing: 0.06em; }
  figcaption a:hover { text-decoration: underline; }
  svg { width: 100%; height: 10px; display: block; border-radius: 3px; overflow: hidden; }
  ul { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-family: var(--mono); font-size: 12px; color: var(--ink-2); }
  li { display: flex; align-items: center; gap: 7px; }
  b { font-weight: 500; color: var(--dim); }
  .sw { width: 9px; height: 9px; border-radius: 2px; background: var(--pc); }
</style>
