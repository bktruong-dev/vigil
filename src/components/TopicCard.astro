---
// A topic brief: a short hand-written explainer plus the latest headlines.
import { type Topic, topicItems, newest, within, linkTo, host, siteOf } from '../lib/feed';
interface Props { topic: Topic; n?: number }
const { topic, n = 3 } = Astro.props;
const list = topicItems(topic);
const week = list.filter(i => within(i, 7)).length;
const latest = newest(list).filter(i => i.kind !== 'video').slice(0, n);
---
<article class="card tcard">
  <p class="label tk"><span>Topic brief</span><span class="wk">{week} this week · {list.length} total</span></p>
  <h3><a class="hl" href={`/topics/${topic.slug}`}>{topic.name}</a></h3>
  <p class="brief">{topic.brief}</p>
  <ul>
    {latest.map(i => (
      <li><a href={linkTo(i)} target="_blank" rel="noopener noreferrer"><span class={`d t-${i.tone}`}></span><span class="ht">{i.title}</span><span class="hs">{siteOf(i)} ↗</span></a></li>
    ))}
  </ul>
  <a class="all" href={`/topics/${topic.slug}`}>Full brief →</a>
</article>

<style>
  .tcard { padding: 18px 20px; display: flex; flex-direction: column; gap: 10px; }
  .tk { margin: 0; display: flex; justify-content: space-between; gap: 10px; color: var(--gold); }
  .wk { color: var(--dim); }
  h3 { margin: 0; font-family: var(--display); font-weight: 600; font-size: 32px; line-height: 1.05; }
  .brief { margin: 0; color: var(--ink-2); font-size: 17px; line-height: 1.55; }
  ul { list-style: none; margin: 4px 0 0; padding: 0; border-top: 1px solid var(--line-2); }
  li a { display: grid; grid-template-columns: 10px minmax(0, 1fr); column-gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line-2); text-decoration: none; }
  .d { width: 6px; height: 6px; border-radius: 50%; background: currentColor; margin-top: 9px; box-shadow: 0 0 6px currentColor; }
  .ht { font-size: 16.5px; line-height: 1.3; color: var(--ink); transition: color .3s var(--ease); }
  .hs { grid-column: 2; font-family: var(--mono); font-size: 11.5px; color: var(--dim); margin-top: 2px; transition: color .3s var(--ease); }
  li a:hover .ht { color: #fff; }
  li a:hover .hs { color: var(--acc); }
  .all { margin-top: auto; align-self: flex-start; }
</style>
