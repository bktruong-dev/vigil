---
import { type Item, KIND_LABEL, TONE_LABEL, PERSPECTIVES, host, siteOf, ago, linkTo, perspectiveOf, readMins } from '../lib/feed';
import Plate from './Plate.astro';

interface Props { item: Item; variant?: 'hero' | 'card' | 'row' | 'text'; eager?: boolean }
const { item, variant = 'card', eager = false } = Astro.props;
const href = linkTo(item);
const p = perspectiveOf(item);
const mins = readMins(item);
const media = item.kind === 'video' ? 'Watch' : 'Read';
const search = `${item.title} ${item.sourceName} ${item.topics.join(' ')} ${item.place?.name ?? ''} ${item.summary}`.toLowerCase();
const showImage = variant !== 'text';
---
<article
  class={`card story rv ${variant} edge-${item.tone}`}
  data-kind={item.kind}
  data-tone={item.tone}
  data-persp={p}
  data-topics={item.topics.join(',')}
  data-search={search}
  data-id={item.id}
  data-date={item.date}
  data-href={href}
  data-title={item.title}
  data-src={item.sourceName}
  data-site={siteOf(item)}
  data-img={item.thumb ?? ''}
  data-tone-label={item.kind === 'incident' ? 'Incident' : TONE_LABEL[item.tone]}
>
  {showImage && (
    <div class="media">
      {!item.thumb && <Plate item={item} />}
      {item.thumb && <img src={item.thumb} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />}
      {(item.kind === 'video' || item.kind === 'podcast') && <span class="play" aria-hidden="true">{item.kind === 'video' ? '▶' : '◖◗'}</span>}
    </div>
  )}
  <div class="body">
    <p class="kicker">
      <span class="newtag" aria-label="New since your last visit">New</span>
      <span class={`pill t-${item.tone}`}><i></i>{item.kind === 'incident' ? 'Incident' : TONE_LABEL[item.tone]}</span>
      {item.kind !== 'incident' && <span class="kind">{KIND_LABEL[item.kind]}</span>}
      {item.place && variant !== 'row' && <span class="place">◎ {item.place.name}</span>}
    </p>
    <h3><a class="hl stretch" href={href} target="_blank" rel="noopener noreferrer">{item.title}</a></h3>
    {(variant === 'hero' || variant === 'card' || variant === 'text') && item.summary && <p class="sum">{item.summary}</p>}
    <p class="meta">
      <span class="src">{item.sourceName}</span>
      <span class={`persp pc-${p}`} title={PERSPECTIVES[p].note}>{PERSPECTIVES[p].label}</span>
      <time datetime={item.date}>{ago(item.date)}</time>
      {mins && variant !== 'row' && <span class="mins">{mins} min read</span>}
      <span class="acts">
        <button class="act save" type="button" aria-pressed="false" aria-label={`Save “${item.title}” for later`} title="Save for later">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5h8v11l-4-3-4 3z" /></svg>
        </button>
        <button class="act share" type="button" aria-label={`Copy link to “${item.title}”`} title="Copy link">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 9.5l3-3M7 4.5l1.2-1.2a2.6 2.6 0 0 1 3.7 3.7L10.7 8.2M9 11.5l-1.2 1.2a2.6 2.6 0 0 1-3.7-3.7L5.3 7.8" /></svg>
        </button>
      </span>
    </p>
    {variant !== 'row' && (
      <div class="foot">
        <a class="out" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${media} “${item.title}” at ${siteOf(item)} (opens in a new tab)`}>
          {media} at <span class="host">{siteOf(item)}</span><span class="arrow">↗</span>
        </a>
        {item.also.length > 0 && (
          <span class="also">
            <span class="label">+{item.also.length} {item.also.length === 1 ? 'source' : 'sources'}</span>
            {item.also.slice(0, 3).map(a => <a class="out" href={a.url} target="_blank" rel="noopener noreferrer"><span class="host">{host(a.url)}</span><span class="arrow">↗</span></a>)}
          </span>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .story { display: flex; flex-direction: column; min-width: 0; overflow: hidden; }
  .media { aspect-ratio: 16 / 9; border-bottom: 1px solid var(--line); flex: none; }
  .body { display: flex; flex-direction: column; gap: 9px; padding: 16px 18px 16px; flex: 1; min-width: 0; }
  .kicker { margin: 0; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--dim); }
  .place { letter-spacing: 0.04em; text-transform: none; color: var(--ink-2); }
  h3 { margin: 0; font-family: var(--serif); font-weight: 560; font-size: 22px; line-height: 1.22; letter-spacing: -0.005em; overflow-wrap: anywhere; color: var(--ink); }
  .sum { margin: 0; color: var(--ink-2); font-size: 17px; line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { margin: 0; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; font-family: var(--mono); font-size: 12px; color: var(--dim); }
  .src { color: var(--ink); font-weight: 500; }
  .foot { margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line-2); display: flex; align-items: center; justify-content: space-between; gap: 10px 18px; flex-wrap: wrap; }
  .out, .also, .persp { position: relative; z-index: 2; }
  .also { display: inline-flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .play { position: absolute; z-index: 2; left: 50%; top: 50%; width: 52px; height: 52px; margin: -26px 0 0 -26px; display: grid; place-items: center; border-radius: 50%; border: 1px solid rgba(238,236,231,0.7); background: rgba(12,13,16,0.6); color: var(--ink); font-size: 15px; backdrop-filter: blur(4px); transition: transform .4s var(--ease), border-color .4s var(--ease), box-shadow .4s var(--ease); }
  .story:hover .play { transform: scale(1.1); border-color: var(--acc); box-shadow: 0 0 24px var(--acc-glow); }

  /* Hero: the lead story */
  .hero .media { aspect-ratio: 16 / 8.6; }
  .hero .body { padding: 22px 26px 22px; gap: 12px; }
  .hero h3 { font-size: clamp(32px, 3.4vw, 48px); line-height: 1.08; font-weight: 600; letter-spacing: -0.015em; }
  .hero .sum { font-size: 21px; -webkit-line-clamp: 4; }

  /* Row: compact list with a thumbnail */
  .row { flex-direction: row; align-items: stretch; }
  .row .media { aspect-ratio: auto; width: 128px; border-bottom: 0; border-right: 1px solid var(--line); }
  .row .body { padding: 12px 14px; gap: 6px; }
  .row h3 { font-size: 18px; line-height: 1.25; }
  .row .kicker { font-size: 10.5px; }

  /* Text: no image (papers, briefs) */
  .text h3 { font-size: 21px; }
  .text .sum { -webkit-line-clamp: 4; font-size: 16.5px; }

  .story[hidden] { display: none; }

  /* New-since-last-visit marker (shown by script) */
  .newtag { display: none; font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; color: var(--bg); background: var(--acc); border-radius: 3px; padding: 1px 6px; }
  .story.is-new .newtag { display: inline-block; animation: newpop 0.6s var(--ease) both; }
  @keyframes newpop { from { transform: scale(0.6); opacity: 0; } }

  /* Save / share */
  .acts { margin-left: auto; display: inline-flex; gap: 4px; position: relative; z-index: 2; }
  .act { width: 30px; height: 30px; display: grid; place-items: center; padding: 0; border: 1px solid transparent; border-radius: 7px; background: none; color: var(--dim); cursor: pointer; transition: color .25s var(--ease), border-color .25s var(--ease), background .25s var(--ease), transform .25s var(--ease); }
  .act svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .act:hover, .act:focus-visible { color: var(--acc); border-color: var(--line); background: var(--well); }
  .act:active { transform: scale(0.9); }
  .save[aria-pressed='true'] { color: var(--gold); }
  .save[aria-pressed='true'] svg { fill: currentColor; }

  @media (max-width: 560px) {
    .row .media { width: 96px; }
    .hero .body { padding: 18px; }
    .hero .sum { font-size: 18px; }
  }
</style>
