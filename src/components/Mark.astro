---
// The Vigil's mark: an open eye with a slowly turning golden spiral as its iris.
interface Props { size?: number }
const { size = 40 } = Astro.props;
const phi = (1 + Math.sqrt(5)) / 2;
const b = Math.log(phi) / (Math.PI / 2);
const pts: string[] = [];
for (let t = -5 * Math.PI; t <= 0.02; t += 0.08) {
  const r = 9.5 * Math.exp(b * t);
  pts.push(`${(32 + r * Math.cos(t)).toFixed(2)},${(32 + r * Math.sin(t)).toFixed(2)}`);
}
---
<svg class="mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <circle cx="32" cy="32" r="29" fill="none" stroke="#2e3138" stroke-width="1" />
  <path d="M7 32c7-11 15.5-16 25-16s18 5 25 16c-7 11-15.5 16-25 16S14 43 7 32z" fill="none" stroke="#e8e6e1" stroke-width="1.6" stroke-linejoin="round" />
  <g class="iris"><polyline points={pts.join(' ')} fill="none" stroke="#86a8ff" stroke-width="1.4" stroke-linecap="round" /></g>
  <circle cx="32" cy="32" r="2.2" fill="#86a8ff" />
</svg>
<style>
  .mark { flex: none; filter: drop-shadow(0 0 6px rgba(134,168,255,0.35)); }
  .iris { transform-origin: 32px 32px; animation: turn 40s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }
</style>
