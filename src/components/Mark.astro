---
// The Vigil's mark: a vigil flame, drawn in one thin line, inside a ring.
// The inner flame flickers gently (off with Motion off / reduced motion).
interface Props { size?: number }
const { size = 40 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <circle class="ring" cx="32" cy="32" r="30" />
  <circle class="ring2" cx="32" cy="32" r="26.5" />
  <path class="outer" d="M32 11c5.5 8.2 10.5 13.6 10.5 21.4a10.5 10.5 0 0 1-21 0C21.5 24.6 26.5 19.2 32 11z" />
  <path class="inner" d="M32 25.5c2.6 3.9 4.4 6.3 4.4 9a4.4 4.4 0 0 1-8.8 0c0-2.7 1.8-5.1 4.4-9z" />
  <path class="base" d="M24.5 48.5h15M28.5 53h7" />
</svg>

<style>
  .mark { flex: none; display: block; overflow: visible; }
  .ring { fill: none; stroke: var(--mark-line); stroke-width: 1.3; }
  .ring2 { fill: none; stroke: var(--line); stroke-width: 0.8; }
  .outer { fill: none; stroke: var(--mark-line); stroke-width: 1.6; stroke-linejoin: round; }
  .inner { fill: var(--mark-flame); transform-box: fill-box; transform-origin: 50% 100%; animation: flicker 3.2s ease-in-out infinite; filter: drop-shadow(0 0 4px var(--mark-glow)); }
  .base { fill: none; stroke: var(--mark-line); stroke-width: 1.4; stroke-linecap: round; }
  @keyframes flicker { 0%, 100% { transform: scale(1, 1); } 30% { transform: scale(0.94, 1.08); } 60% { transform: scale(1.04, 0.95); } }
  :global(html.no-motion) .inner { animation: none; }
  @media (prefers-reduced-motion: reduce) { .inner { animation: none; } }
</style>
