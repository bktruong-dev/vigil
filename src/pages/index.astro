---
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import Mix from '../components/Mix.astro';
import TopicCard from '../components/TopicCard.astro';
import { JURISDICTIONS } from '../data/policy';
import { items, SECTIONS, sectionItems, TOPICS, topicItems, within, sources, newest, stories, storyItems, trendingKeys, ago, siteOf } from '../lib/feed';
import Plate from '../components/Plate.astro';

const sec = Object.fromEntries(SECTIONS.map(s => [s.slug, sectionItems(s)]));
const used = new Set<string>();
const take = <T extends { id: string }>(list: T[], n: number) => {
  const out = list.filter(i => !used.has(i.id)).slice(0, n);
  out.forEach(i => used.add(i.id));
  return out;
};
const headline = items.filter(i => i.kind === 'news' || i.kind === 'lab' || i.kind === 'incident' || i.kind === 'essay');
// Lead: the best-ranked story that has an image.
const lead = take(headline.filter(i => i.thumb), 1)[0] ?? take(headline, 1)[0];
// Top stories: one per source, for range.
const seenSrc = new Set([lead.source]);
const top = take(headline.filter(i => !seenSrc.has(i.source) && seenSrc.add(i.source)), 5);
const latest = take(sec.latest.filter(i => i.kind !== 'paper'), 4);
const research = take(sec.research.filter(i => i.kind === 'paper'), 3);
const essays = take(sec.research.filter(i => i.kind === 'essay'), 4);
const videos = take(sec.watch, 4);
const incidents = take(sec.incidents, 4);
const good = take(sec['good-news'], 4);
const hotTopics = [...TOPICS].sort((a, b) => topicItems(b).filter(i => within(i, 7)).length - topicItems(a).filter(i => within(i, 7)).length);

const day = items.filter(i => within(i, 1));
const stats = [
  ['New in 24 hours', day.length, '/latest'],
  ['Incidents · 7 days', items.filter(i => i.kind === 'incident' && within(i, 7)).length, '/incidents'],
  ['Papers · 7 days', items.filter(i => i.kind === 'paper' && within(i, 7)).length, '/research'],
  ['Good news · 7 days', items.filter(i => i.tone === 'good' && within(i, 7)).length, '/good-news'],
] as const;
// Developing stories: groups of reports about the same event, found hourly.
const developing = stories.slice(0, 6).map(st => {
  const list = storyItems(st);
  return { st, list, pic: list.find(i => i.thumb && i.kind !== 'video') ?? list.find(i => i.thumb) ?? list[0] };
});
const trending = trendingKeys(items, 10);
---
<Base current="/">
  <div class="wrap">
    <section class="front" aria-label="Top stories">
      <div class="lead"><Story item={lead} variant="hero" eager /></div>
      <aside class="top">
        <p class="label kicker"><span class="dot"></span> Top stories</p>
        <div class="stack">{top.map(i => <Story item={i} variant="row" />)}</div>
      </aside>
    </section>

    {developing.length > 0 && (
      <section class="block dev" aria-labelledby="dev-h">
        <header class="sec-head"><span class="num">◆</span><h2 id="dev-h">Developing stories</h2><span class="label all-note">Grouped automatically from {sources.length} sources · updated hourly</span></header>
        <div class="devgrid">
          {developing.map(({ st, list, pic }, n) => (
            <article class={`card dcard rv ${n === 0 ? 'big' : ''}`}>
              <div class="media">
                {pic.thumb ? <img src={pic.thumb} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <Plate item={pic} />}
              </div>
              <div class="db">
                <p class="dk label"><i aria-hidden="true"></i>{list.length} reports · {st.sources} {st.sources === 1 ? 'source' : 'sources'} · {ago(st.last)}</p>
                <h3><a class="hl stretch" href={`/story/${st.id}`}>{st.label}</a></h3>
                <p class="dsrc">{[...new Set(list.map(i => i.sourceName))].slice(0, 4).join(' · ')}</p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="today" aria-labelledby="today-h">
      <h2 id="today-h" class="label">Today in AI safety</h2>
      <dl class="stats">
        {stats.map(([k, v, href]) => <div><dt class="label">{k}</dt><dd><a href={href}>{v}</a></dd></div>)}
      </dl>
      <div class="trend">
        <p class="label">Trending right now</p>
        <ul>{trending.map(({ k, n }) => <li><a class="btn" href={`/latest?k=${encodeURIComponent(k.toLowerCase())}#stories`}>{k} <span>{n}</span></a></li>)}</ul>
      </div>
      <div class="mixw"><Mix list={items} label="Who is speaking in today’s edition" /></div>
    </section>

    <section class="block" aria-labelledby="latest-h">
      <header class="sec-head"><span class="num">I.</span><h2 id="latest-h"><a href="/latest">Latest</a></h2><a class="all" href="/latest">All {sec.latest.length} stories →</a></header>
      <div class="g4">{latest.map(i => <Story item={i} />)}</div>
    </section>

    <section class="block" aria-labelledby="topics-h">
      <header class="sec-head"><span class="num">VII.</span><h2 id="topics-h"><a href="/topics">The big topics, briefly</a></h2><a class="all" href="/topics">All topics →</a></header>
      <div class="g3">{hotTopics.slice(0, 3).map(t => <TopicCard topic={t} />)}</div>
    </section>

    <section class="block" aria-labelledby="policy-h">
      <header class="sec-head"><span class="num">XI.</span><h2 id="policy-h"><a href="/policy">Policy &amp; Law</a></h2><a class="all" href="/policy">The full guide →</a><span class="dek">Who makes the rules for AI, and what is coming next.</span></header>
      <div class="pstrip">
        {JURISDICTIONS.map(j => (
          <a class="card pcard" href={`/policy#${j.slug}`}>
            <span class="pcode">{j.code}</span>
            <span class="pname">{j.name}</span>
            <span class="pwatch">{j.watch}</span>
          </a>
        ))}
      </div>
    </section>


    <section class="block" aria-labelledby="research-h">
      <header class="sec-head"><span class="num">II.</span><h2 id="research-h"><a href="/research">Research</a></h2><a class="all" href="/research">All research →</a><span class="dek">New preprints and essays. Preprints are not yet peer-reviewed.</span></header>
      <div class="journal">
        <div class="papers">
          <p class="label colhead">New papers · arXiv</p>
          {research.map(i => <Story item={i} variant="text" />)}
        </div>
        <div class="essays">
          <p class="label colhead">Essays &amp; newsletters</p>
          {essays.map(i => <Story item={i} variant="row" />)}
        </div>
      </div>
    </section>


    <section class="block" aria-labelledby="watch-h">
      <header class="sec-head"><span class="num">III.</span><h2 id="watch-h"><a href="/watch">Watch</a></h2><a class="all" href="/watch">All videos →</a></header>
      <div class="g4">{videos.map(i => <Story item={i} />)}</div>
    </section>

    <section class="block two" aria-label="Incidents and good news">
      <div>
        <header class="sec-head"><span class="num">IV.</span><h2><a href="/incidents">Incidents</a></h2><a class="all" href="/incidents">All →</a></header>
        <div class="stack">{incidents.map(i => <Story item={i} variant="row" />)}</div>
      </div>
      <div>
        <header class="sec-head"><span class="num">V.</span><h2><a href="/good-news">Good News</a></h2><a class="all" href="/good-news">All →</a></header>
        <div class="stack">{good.map(i => <Story item={i} variant="row" />)}</div>
      </div>
    </section>

    <section class="block guide" aria-labelledby="guide-h">
      <header class="sec-head"><span class="num">VIII.</span><h2 id="guide-h"><a href="/guide">New to AI safety?</a></h2></header>
      <p class="intro">Start with the <a href="/guide">Guide</a>: hand-picked courses, reading, organisations and fellowships, plus <a href="/guide#sources">all {sources.length} sources</a> we read, who they are, and exactly how stories are ranked.</p>
    </section>
  </div>
</Base>

<style>
  .front { display: grid; grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr); gap: 24px; padding: 30px 0 0; }
  .kicker { margin: 0 0 12px; display: flex; align-items: center; gap: 8px; }
  .kicker .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--risk); box-shadow: 0 0 10px var(--risk); }
  .stack { display: grid; gap: 12px; }

  .today { margin-top: 36px; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 18px 36px; align-items: center; padding: 20px 24px; border: 1px solid var(--line); border-radius: 12px; background: linear-gradient(180deg, var(--card), var(--card-2)); }
  .today h2 { grid-column: 1 / -1; margin: 0; color: var(--gold); }
  .stats { margin: 0; display: flex; gap: 32px; flex-wrap: wrap; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-family: var(--mono); font-size: 36px; line-height: 1; }
  .stats dd a { text-decoration: none; transition: color .3s var(--ease), text-shadow .3s var(--ease); }
  .stats dd a:hover { color: var(--acc); text-shadow: 0 0 18px var(--acc-glow); }
  .stats dt { margin-top: 6px; font-size: 11px; }
  .trend .label { margin: 0 0 8px; }
  .trend ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .trend a { text-decoration: none; display: inline-flex; gap: 8px; }
  .trend a span { color: var(--acc); }
  .mixw { grid-column: 1 / -1; padding-top: 14px; border-top: 1px solid var(--line-2); }

  .block { margin-top: 72px; scroll-margin-top: 70px; }
  .g4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .g3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .g2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .journal { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 24px; }
  .papers, .essays { display: grid; gap: 14px; align-content: start; }
  .colhead { margin: 0; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .dev .all-note { margin-left: auto; }
  .devgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .dcard { overflow: hidden; display: flex; flex-direction: column; --edge: var(--gold); }
  .dcard .media { aspect-ratio: 16 / 9; border-bottom: 1px solid var(--line); }
  .dcard.big { grid-column: span 2; grid-row: span 2; }
  .dcard.big .media { aspect-ratio: 16 / 8; }
  .dcard.big h3 { font-size: clamp(26px, 2.6vw, 36px); line-height: 1.12; }
  .db { padding: 14px 18px 16px; display: flex; flex-direction: column; gap: 8px; }
  .dk { margin: 0; display: flex; align-items: center; gap: 8px; color: var(--gold); }
  .dk i { width: 7px; height: 7px; transform: rotate(45deg); background: var(--gold); }
  .dcard h3 { margin: 0; font-family: var(--serif); font-weight: 580; font-size: 20px; line-height: 1.25; }
  .dsrc { margin: 0; font-family: var(--mono); font-size: 12px; color: var(--dim); }
  .pstrip { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; }
  .pcard { display: flex; flex-direction: column; gap: 6px; padding: 16px; text-decoration: none; transition: transform .35s var(--ease); }
  .pcard:hover { transform: translateY(-3px); }
  .pcode { font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; color: var(--acc); }
  .pname { font-family: var(--display); font-weight: 600; font-size: 24px; line-height: 1.05; }
  .pwatch { font-size: 15px; line-height: 1.45; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .tlall { margin: 6px 0 0; text-align: center; }
  .guide .intro { font-size: 22px; color: var(--ink-2); max-width: 780px; margin: 0; }
  .guide a { color: var(--acc); }

  @media (max-width: 1150px) {
    .devgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pstrip { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .g4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .g3 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 900px) {
    .front, .journal, .two, .g2 { grid-template-columns: minmax(0, 1fr); }
    .today { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .devgrid { grid-template-columns: minmax(0, 1fr); }
    .dcard.big { grid-column: auto; grid-row: auto; }
    .pstrip { grid-template-columns: minmax(0, 1fr); }
    .g4, .g3 { grid-template-columns: minmax(0, 1fr); }
    .stats { gap: 22px; }
    .stats dd { font-size: 28px; }
    .block { margin-top: 56px; }
  }
</style>
