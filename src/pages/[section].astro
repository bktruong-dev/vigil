---
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import Mix from '../components/Mix.astro';
import Timeline from '../components/Timeline.astro';
import Atlas from '../components/Atlas.astro';
import { items as allItems } from '../lib/feed';
import { SECTIONS, sectionItems, PERSPECTIVES, perspectiveOf, trendingKeys, type Section } from '../lib/feed';

export function getStaticPaths() {
  return SECTIONS.map(s => ({ params: { section: s.slug }, props: { s } }));
}
const { s } = Astro.props as { s: Section };
const list = sectionItems(s).slice(0, 150);
const [lead, ...rest] = list;
const side = s.slug === 'watch' ? [] : rest.slice(0, 3);
const grid = rest.slice(side.length);

// Filters offered on this page: its most common topics and perspectives.
// Filters follow the news: the phrases trending in this section right now.
const trending = trendingKeys(list, 9);
const persps = [...new Set(list.map(perspectiveOf))];
---
<Base title={s.title} current={`/${s.slug}`} description={s.dek} compact>
  <div class="wrap page">
    <header class="phead">
      <div>
        <p class="label crumb"><a href="/">Front Page</a> / Section {s.num}</p>
        <h1><span class="num">{s.num}.</span> {s.title}</h1>
        <p class="dek">{s.dek}</p>
        <p class="label count">{list.length} stories · every link opens the original source</p>
        {s.slug === 'latest' && <p class="jump"><a class="btn" href="#stories">Stories</a><a class="btn" href="#record">The Record (timeline)</a><a class="btn" href="#atlas">The Atlas (map)</a></p>}
      </div>
      <div class="mixbox"><Mix list={list} label="Who is speaking on this page" /></div>
    </header>

    {lead && (
      <section class={`top ${side.length ? '' : 'solo'}`} aria-label="Top stories">
        <Story item={lead} variant="hero" eager />
        {side.length > 0 && <div class="side">{side.map(i => <Story item={i} variant="row" />)}</div>}
      </section>
    )}

    <div class="tools" id="stories">
      <div class="chips" role="group" aria-label="Filter by trending phrase">
        <span class="label trend-k">Trending</span>
        <button class="btn" type="button" data-f="key" data-v="all" aria-pressed="true">Everything</button>
        {trending.map(({ k, n }) => <button class="btn" type="button" data-f="key" data-v={k.toLowerCase()} aria-pressed="false">{k} <span class="cnt">{n}</span></button>)}
      </div>
      <div class="right">
        <label class="sel"><span class="visually-hidden">Filter by perspective</span>
          <select id="persp">
            <option value="all">All perspectives</option>
            {persps.map(p => <option value={p}>{PERSPECTIVES[p].label}</option>)}
          </select>
        </label>
        <label class="search"><span class="visually-hidden">Search this section</span>
          <input type="search" id="q" placeholder="Search…" autocomplete="off" spellcheck="false" />
        </label>
      </div>
    </div>

    <div class={`grid ${s.slug === 'watch' ? 'vids' : ''}`} id="stream">
      {grid.map(i => <Story item={i} />)}
    </div>
    <p class="empty label" id="empty" hidden>Nothing matches. Try another word or filter.</p>
    <div class="morewrap"><button class="btn" type="button" id="more">Show more</button></div>

    {s.slug === 'latest' && (
      <>
        <div class="extra" id="record"><Timeline list={allItems} limit={40} filters id="record-tl" title="The Record" dek="Every story in the order it happened, grouped by day (UTC). Filter by category to follow one thread." /></div>
        <div class="extra" id="atlas"><Atlas /></div>
      </>
    )}
  </div>
</Base>

<script>
  import '../scripts/filters.ts';
</script>

<style>
  .page { padding-top: 34px; }
  .phead { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 40px; align-items: end; border-bottom: 2px solid var(--ink); padding-bottom: 22px; margin-bottom: 28px; }
  .crumb { margin: 0 0 6px; }
  .crumb a { color: var(--acc); text-decoration: none; }
  h1 { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(48px, 6vw, 84px); line-height: 0.98; }
  h1 .num { color: var(--acc); font-size: 0.5em; vertical-align: 0.5em; font-family: var(--mono); font-weight: 400; }
  .dek { margin: 10px 0 8px; font-size: 21px; color: var(--ink-2); max-width: 680px; }
  .count { margin: 0; }
  .top { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 20px; margin-bottom: 40px; }
  .top.solo { grid-template-columns: minmax(0, 1fr); max-width: 980px; }
  .side { display: grid; gap: 14px; align-content: start; }
  .tools { display: flex; justify-content: space-between; align-items: center; gap: 14px; flex-wrap: wrap; margin-bottom: 20px; padding-top: 18px; border-top: 1px solid var(--line); }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .trend-k { color: var(--gold); margin-right: 4px; }
  .chips .cnt { color: var(--acc); margin-left: 4px; }
  .chips [aria-pressed="true"] .cnt { color: inherit; }
  .right { display: flex; gap: 10px; flex-wrap: wrap; }
  select, .search input { font: 15px var(--mono); color: var(--ink); background: var(--well); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; }
  .search input { width: min(260px, 80vw); }
  select:focus, .search input:focus { outline: none; border-color: var(--acc); box-shadow: 0 0 0 3px rgba(134,168,255,0.15); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr)); gap: 18px; }
  .grid.vids { grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .empty { text-align: center; padding: 30px 0; }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; }
  .jump .btn { text-decoration: none; }
  .extra { margin-top: 90px; scroll-margin-top: 80px; }
  #stories { scroll-margin-top: 80px; }
  .morewrap { display: flex; justify-content: center; margin-top: 24px; }
  @media (max-width: 960px) {
    .phead, .top { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
</style>
