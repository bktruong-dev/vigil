---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Mix from '../components/Mix.astro';
import { items } from '../lib/feed';
---
<Base title="Timeline" current="/timeline" description="Every AI safety story in the order it happened: incidents, security, policy and research, each linked to its source.">
  <div class="wrap page">
    <header class="phead">
      <div>
        <p class="label crumb"><a href="/">Front Page</a> / Section X</p>
        <h1><span class="num">X.</span> The Record</h1>
        <p class="dek">What happened in AI safety, day by day. Filter by category to follow one thread: security, policy, incidents, alignment research and more.</p>
      </div>
      <div class="mixbox"><Mix list={items} label="Who is speaking in the record" /></div>
    </header>
    <Timeline list={items} limit={60} filters dek="Every story in the order it happened, grouped by day (UTC). Each one links to the original source, and stories covered by several outlets are merged into one entry." />
  </div>
</Base>

<style>
  .page { padding-top: 34px; }
  .phead { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 40px; align-items: end; border-bottom: 2px solid var(--rule); padding-bottom: 22px; margin-bottom: 40px; }
  .crumb { margin: 0 0 6px; }
  .crumb a { color: var(--acc); text-decoration: none; }
  h1 { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(48px, 6vw, 84px); line-height: 0.98; }
  h1 .num { color: var(--acc); font-size: 0.45em; vertical-align: 0.6em; font-family: var(--mono); font-weight: 400; }
  .dek { margin: 10px 0 0; font-size: 20px; color: var(--ink-2); max-width: 680px; }
  @media (max-width: 900px) { .phead { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
</style>
