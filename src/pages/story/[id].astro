---
// One developing story: every report about the same event, grouped
// automatically by the collector, with its own timeline.
import Base from '../../layouts/Base.astro';
import Story from '../../components/Story.astro';
import Timeline from '../../components/Timeline.astro';
import Mix from '../../components/Mix.astro';
import { stories, storyItems, fmtDate, type StoryGroup } from '../../lib/feed';

export function getStaticPaths() {
  return stories.map(s => ({ params: { id: s.id }, props: { s } }));
}
const { s } = Astro.props as { s: StoryGroup };
const list = storyItems(s);
const lead = list.find(i => i.thumb && i.kind !== 'video') ?? list[0];
const rest = list.filter(i => i !== lead);
const related = stories.filter(o => o.id !== s.id && o.terms.some(t => s.terms.includes(t))).slice(0, 4);
const spanH = (Date.parse(s.last) - Date.parse(s.first)) / 36e5;
const span = spanH < 1 ? 'within the hour' : spanH < 48 ? `over ${Math.round(spanH)} hours` : `over ${Math.round(spanH / 24)} days`;
---
<Base title={s.label} description={`A developing AI safety story: ${list.length} reports from ${s.sources} sources.`}>
  <div class="wrap page">
    <header class="phead">
      <p class="label crumb"><a href="/">Front Page</a> / Developing story</p>
      <h1>{s.label}</h1>
      <p class="facts label">
        <span><b>{list.length}</b> reports</span><span><b>{s.sources}</b> sources</span>
        <span>{fmtDate(s.first)}{s.first.slice(0, 10) !== s.last.slice(0, 10) && ` – ${fmtDate(s.last)}`}, {span}</span>
      </p>
      <ul class="terms">{s.terms.map(t => <li>{t}</li>)}</ul>
      <p class="how">Grouped automatically: these reports share unusual words and phrases and were published close together. Each links to its original source.</p>
    </header>

    <section class="top">
      <div class="lead"><Story item={lead} variant="hero" eager /></div>
      <aside>
        <Mix list={list} label="Who is reporting this" />
        <p class="label k">Coverage</p>
        <div class="stack">{rest.slice(0, 4).map(i => <Story item={i} variant="row" />)}</div>
      </aside>
    </section>

    <div class="tl"><Timeline list={list} limit={50} id="story-tl" title="How it unfolded" dek="Every report in the order it was published (UTC)." /></div>

    {related.length > 0 && (
      <section class="rel">
        <header class="sec-head"><span class="num">◆</span><h2>Related developing stories</h2></header>
        <ul>{related.map(o => <li><a class="card rl" href={`/story/${o.id}`}><span class="rt">{o.label}</span><span class="label">{o.items.length} reports · {o.sources} sources</span></a></li>)}</ul>
      </section>
    )}
  </div>
</Base>

<style>
  .page { padding-top: 34px; }
  .phead { border-bottom: 2px solid var(--rule); padding-bottom: 20px; margin-bottom: 28px; max-width: 1000px; }
  .crumb { margin: 0 0 8px; color: var(--gold); }
  .crumb a { color: var(--acc); text-decoration: none; }
  h1 { margin: 0; font-family: var(--serif); font-weight: 620; font-size: clamp(32px, 4vw, 54px); line-height: 1.1; letter-spacing: -0.01em; }
  .facts { display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 14px 0 10px; }
  .facts b { color: var(--ink); font-weight: 500; }
  .terms { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .terms li { font-family: var(--mono); font-size: 12px; color: var(--gold); border: 1px solid color-mix(in srgb, var(--gold) 40%, transparent); border-radius: 999px; padding: 2px 10px; }
  .how { margin: 12px 0 0; color: var(--dim); font-size: 15px; }
  .top { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px; }
  .k { margin: 22px 0 10px; }
  .stack { display: grid; gap: 12px; }
  .tl { margin-top: 64px; }
  .rel { margin-top: 64px; }
  .rel ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px; }
  .rl { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; text-decoration: none; }
  .rt { font-family: var(--serif); font-weight: 580; font-size: 18px; line-height: 1.3; }
  @media (max-width: 900px) { .top { grid-template-columns: minmax(0, 1fr); } }
</style>
