---
import Base from '../layouts/Base.astro';
import Mix from '../components/Mix.astro';
import { sources, items, generated, KIND_LABEL, host, PERSPECTIVES, PERSPECTIVE_ORDER } from '../lib/feed';

// Hand-picked starting points. Edit this list freely.
const shelves: { title: string; note: string; links: [string, string, string][] }[] = [
  {
    title: 'Start here', note: 'Free courses and overviews for newcomers.',
    links: [
      ['AI Safety Fundamentals', 'https://bluedot.org', 'BlueDot Impact’s free online courses on alignment and governance.'],
      ['AI Safety, Ethics and Society', 'https://www.aisafetybook.com', 'A free textbook from the Center for AI Safety.'],
      ['International AI Safety Report', 'https://internationalaisafetyreport.org', 'The science of advanced AI risks, written by experts from many countries.'],
      ['AISafety.com', 'https://www.aisafety.com', 'A map of the field: courses, communities, funders, jobs.'],
    ],
  },
  {
    title: 'Watch & listen', note: 'Good first videos and podcasts.',
    links: [
      ['Robert Miles AI Safety', 'https://www.youtube.com/@RobertMilesAI', 'Clear, friendly explainers of core alignment problems.'],
      ['Rational Animations', 'https://www.youtube.com/@RationalAnimations', 'Animated stories and explainers about AI risk.'],
      ['AXRP', 'https://axrp.net', 'Long interviews with alignment researchers about their papers.'],
      ['80,000 Hours Podcast', 'https://80000hours.org/podcast/', 'In-depth conversations on AI and the world’s biggest problems.'],
    ],
  },
  {
    title: 'Key reading', note: 'Papers and essays people point to.',
    links: [
      ['Concrete Problems in AI Safety', 'https://arxiv.org/abs/1606.06565', 'A classic 2016 paper that framed many open problems.'],
      ['Core Views on AI Safety', 'https://www.anthropic.com/news/core-views-on-ai-safety', 'Anthropic on why and how it works on safety.'],
      ['Alignment Forum Library', 'https://www.alignmentforum.org/library', 'Curated sequences from alignment researchers.'],
      ['Import AI', 'https://importai.substack.com', 'A weekly newsletter on AI research and policy.'],
    ],
  },
  {
    title: 'Careers & fellowships', note: 'Ways into the field.',
    links: [
      ['80,000 Hours: AI risk', 'https://80000hours.org/problem-profiles/artificial-intelligence/', 'Career guide to reducing risks from AI.'],
      ['MATS', 'https://www.matsprogram.org', 'A research mentorship programme for aspiring alignment researchers.'],
      ['ARENA', 'https://www.arena.education', 'Hands-on technical training in ML safety engineering.'],
      ['Events & training', 'https://www.aisafety.com/events-and-training', 'Upcoming conferences, workshops and programmes.'],
    ],
  },
  {
    title: 'Organisations', note: 'Labs, institutes and non-profits doing the work.',
    links: [
      ['UK AI Security Institute', 'https://www.aisi.gov.uk', 'The UK government’s institute for testing advanced AI.'],
      ['METR', 'https://metr.org', 'Evaluates frontier AI for dangerous capabilities.'],
      ['Apollo Research', 'https://www.apolloresearch.ai', 'Studies deception and scheming in AI systems.'],
      ['Redwood Research', 'https://www.redwoodresearch.org', 'Research on AI control and alignment.'],
      ['Center for AI Safety', 'https://safe.ai', 'Research and field-building to reduce AI risk.'],
      ['FAR.AI', 'https://far.ai', 'Technical research on robustness and alignment.'],
    ],
  },
  {
    title: 'At universities', note: 'Academic centres with public programmes.',
    links: [
      ['Center for Human-Compatible AI', 'https://humancompatible.ai', 'UC Berkeley.'],
      ['Stanford Center for AI Safety', 'https://aisafety.stanford.edu', 'Stanford University.'],
      ['Mila', 'https://mila.quebec/en', 'Quebec AI Institute, Montreal.'],
      ['Centre for the Study of Existential Risk', 'https://www.cser.ac.uk', 'University of Cambridge.'],
    ],
  },
];
const groups = Object.entries(Object.groupBy(sources, s => s.kind)) as [keyof typeof KIND_LABEL, typeof sources][];
const placed = items.filter(i => i.place).length;
const ROMAN = ['i', 'ii', 'iii', 'iv', 'v', 'vi'];
---
<Base title="Guide & Sources" current="/guide" description="A way into AI safety: hand-picked courses, reading, careers and organisations, plus every source The Vigil reads and how stories are ranked.">
  <div class="wrap page">
    <header class="intro">
      <p class="label"><a href="/">Front Page</a> / Section VIII</p>
      <h1><span class="num">VIII.</span> Guide &amp; Sources</h1>
      <p class="lede">Two things in one place: a hand-picked way into AI safety, and full transparency about where every story on The Vigil comes from. Every link goes to the original site.</p>
      <nav class="jump" aria-label="On this page">
        <span class="label">Part A — The guide</span>
        {shelves.map((s, n) => <a class="btn" href={`#g${n}`}>{s.title}</a>)}
        <span class="label">Part B — Sources &amp; method</span>
        <a class="btn" href="#sources">The sources</a><a class="btn" href="#perspective">Perspective</a><a class="btn" href="#algorithm">How stories are ranked</a><a class="btn" href="#no-h">What we don’t do</a>
      </nav>
    </header>

    <h2 class="part">Part A <span>The guide</span></h2>
    {shelves.map((s, n) => (
      <section class="block" aria-labelledby={`g${n}`}>
        <header class="sec-head"><span class="num">A.{ROMAN[n]}</span><h2 id={`g${n}`}>{s.title}</h2><span class="label more">{s.note}</span></header>
        <ul class="shelf">
          {s.links.map(([name, url, note]) => (
            <li class="card item">
              <h3><a class="hl stretch" href={url} target="_blank" rel="noopener noreferrer">{name}</a></h3>
              <p>{note}</p>
              <span class="out"><span class="host">{host(url)}</span><span class="arrow">↗</span></span>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <h2 class="part">Part B <span>Sources &amp; method</span></h2>
    <p class="lede">The Vigil doesn’t write the news. It reads {sources.length} public sources, keeps the AI safety stories, ranks them and sends you to the original. We only show a title, a short excerpt and the publisher’s preview image. Links highlight the passage you saw here when the original page opens (in Chrome, Edge and Safari).</p>
    <p class="label">Last updated <time datetime={generated.toISOString()} data-ago>{generated.toISOString()}</time> · {items.length} stories · {placed} on the map</p>

    <section class="block" id="sources" aria-labelledby="src-h">
      <header class="sec-head"><span class="num">B.i</span><h2 id="src-h">The sources</h2><span class="label more">{sources.length} sources · {sources.filter(x => x.ok).length} live now</span></header>
      {groups.map(([kind, list]) => (
        <div class="group">
          <p class="label gk">{KIND_LABEL[kind]}{kind === 'video' ? 's · YouTube channels' : kind === 'news' ? ' outlets' : 's'}</p>
          <ul class="src-list">
            {list.map(s => (
              <li class="card src">
                <div class="sn">
                  <span class={`st ${s.ok ? 'ok' : 'down'}`} title={s.ok ? 'Live' : `Unavailable: ${s.error}`}></span>
                  <a class="hl" href={s.home} target="_blank" rel="noopener noreferrer">{s.name}</a>
                </div>
                <div class="sm label">
                  <span class={`persp pc-${s.perspective}`} title={PERSPECTIVES[s.perspective].note}>{PERSPECTIVES[s.perspective].label}</span>
                  <span>{s.count} stories</span>
                  <span>Trust {Math.round(s.trust * 100)}</span>
                  <span>{s.minScore === 0 ? 'All posts' : s.minScore === 1 ? 'Safety-related posts' : 'Clear safety stories only'}</span>
                </div>
                <a class="out" href={s.feed} target="_blank" rel="noopener noreferrer"><span class="host">{s.id === 'anthropic' ? 'sitemap' : 'feed'} · {host(s.feed)}</span><span class="arrow">↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="block" id="perspective" aria-labelledby="per-h">
      <header class="sec-head"><span class="num">B.ii</span><h2 id="per-h">Perspective: who is speaking</h2></header>
      <p class="lede small">Every story carries a perspective label, so you can see who is speaking and weigh it. An AI company writing about its own model is not the same as a reporter covering it. We don’t score outlets as “left” or “right”; we label what kind of voice each source is, which matters more for AI safety. Each page shows its perspective mix as a bar.</p>
      <dl class="plist">
        {PERSPECTIVE_ORDER.map(p => <div><dt><span class={`persp pc-${p}`}>{PERSPECTIVES[p].label}</span></dt><dd>{PERSPECTIVES[p].note}</dd></div>)}
      </dl>
      <div class="mixw"><Mix list={items} label="Today’s edition" /></div>
    </section>

    <section class="block" id="algorithm" aria-labelledby="alg-h">
      <header class="sec-head"><span class="num">B.iii</span><h2 id="alg-h">How stories are ranked</h2></header>
      <ol class="steps">
        <li><span class="label">Step 1 — Collect</span><p>Every hour a script reads each source’s official public feed (RSS, Atom, the arXiv API or YouTube’s channel feeds), plus a light web search: a few Google News and Hacker News searches that find AI safety stories from outlets we don’t follow directly. If YouTube’s feed service is down, it reads the channel’s public Videos page instead. A failed source keeps its last stories, so nothing breaks. Anthropic has no feed, so we read its public sitemap and each post’s own title and date.</p></li>
        <li><span class="label">Step 2 — Relevance</span><p>Each story is scored against a weighted list of AI safety terms: alignment, interpretability, jailbreaks, red-teaming, evaluations, governance, misuse and more. General tech outlets must show a clear safety signal; safety-focused sources are kept whole.</p></li>
        <li><span class="label">Step 3 — Rank</span>
          <p class="formula"><span>score</span> = 0.45 × <span>relevance</span> + 0.25 × <span>source trust</span> + 0.30 × <span>freshness</span> + <span>coverage</span></p>
          <p>Freshness fades smoothly with age (it halves about every three days), so the front page turns over on its own. Coverage adds a small bonus when several outlets report the same story.</p></li>
        <li><span class="label">Step 4 — Merge</span><p>When different outlets cover the same story, they become one entry with “Also covered by” links. Multiple reports of the same incident are grouped using the AI Incident Database’s incident number.</p></li>
        <li><span class="label">Step 5 — Tone and place</span><p>A word list marks each story as a risk, good news, research or a general update. Good news needs a clear positive event (a law passed, new funding, a new safeguard) and no risk language in the headline; anything describing harm, deception or failure is filed as a risk. A place name in the headline (or else the company’s headquarters) puts it on the map. Both are automatic and approximate.</p></li>
        <li><span class="label">Step 6 — Developing stories and trending phrases</span><p>No AI model is involved. Each headline and summary is turned into words and two-word phrases, weighted by how rare they are across everything we collected (TF-IDF): a word like “Mythos” counts for a lot, “AI” for nothing. Reports that share enough rare words, published within a few days of each other, are grouped into a developing story, titled by its most representative headline. The same phrases power the trending filters on every page, so they change every hour with the news.</p></li>
      </ol>
    </section>

    <section class="block" aria-labelledby="no-h">
      <header class="sec-head"><span class="num">B.iv</span><h2 id="no-h">What we don’t do</h2></header>
      <ul class="nots">
        <li>No full articles. Headlines, short excerpts and a link: the original site gets the visit.</li>
        <li>No AI-written summaries. The excerpt is the publisher’s own description; topic briefs are written by hand.</li>
        <li>Images are the preview images publishers provide for sharing, loaded from their own servers and linked to the article.</li>
        <li>No tracking, cookies, ads or accounts.</li>
        <li>No paid APIs. Everything runs on free public feeds.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .page { padding-top: 40px; }
  .intro h1 { font-style: italic; font-weight: 500; font-size: clamp(38px, 5vw, 64px); line-height: 1.05; margin: 8px 0 14px; }
  .lede { font-size: 22px; color: var(--ink-2); max-width: 760px; margin: 0; }
  .block { margin-top: 56px; }
  .more { margin-left: auto; }
  .shelf { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 14px; }
  .item { padding: 16px 18px; display: flex; flex-direction: column; gap: 6px; }
  .item h3 { margin: 0; font-weight: 500; font-size: 22px; line-height: 1.2; }
  .item p { margin: 0 0 6px; color: var(--ink-2); font-size: 16.5px; }
  .item .out { margin-top: auto; align-self: flex-start; }
  .card:hover .out { background: rgba(134,168,255,0.08); }
  .card:hover .out .arrow { transform: translate(3px, -3px); }

  /* from the old Sources page */
  .page { padding-top: 40px; }
  .intro h1 { font-style: italic; font-weight: 500; font-size: clamp(38px, 5vw, 64px); line-height: 1.05; margin: 8px 0 14px; }
  .lede { font-size: 22px; color: var(--ink-2); max-width: 820px; margin: 0 0 14px; }
  .block { margin-top: 64px; }
  .group { margin-bottom: 28px; }
  .gk { margin: 0 0 10px; color: var(--gold); }
  .src-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 12px; }
  .src { padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; }
  .sn { display: flex; align-items: center; gap: 10px; font-size: 21px; }
  .sn a { text-decoration: none; }
  .st { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .st.ok { background: var(--good); box-shadow: 0 0 8px var(--good); }
  .st.down { background: var(--risk); box-shadow: 0 0 8px var(--risk); }
  .sm { display: flex; gap: 14px; flex-wrap: wrap; font-size: 10px; }
  .src .out { align-self: flex-start; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; counter-reset: s; max-width: 900px; }
  .steps li { border-left: 1px solid var(--line); padding: 4px 0 4px 22px; position: relative; }
  .steps li::before { content: ''; position: absolute; left: -4px; top: 9px; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 10px var(--acc); }
  .steps .label { color: var(--acc); }
  .steps p { margin: 6px 0 0; font-size: 19px; color: var(--ink-2); }
  .formula { font-family: var(--mono); font-size: 14px !important; background: var(--well); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; color: var(--ink) !important; overflow-x: auto; }
  .formula span { color: var(--gold); }
  .nots { margin: 0; padding-left: 20px; font-size: 19px; color: var(--ink-2); display: grid; gap: 8px; max-width: 820px; }
  .small { font-size: 19px; margin-bottom: 18px; }
  .plist { margin: 0 0 22px; display: grid; gap: 10px; max-width: 860px; }
  .plist div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 14px; align-items: baseline; }
  .plist dd { margin: 0; color: var(--ink-2); font-size: 17.5px; }
  .mixw { max-width: 860px; }
  .intro h1 { font-family: var(--display); }
  .nots li::marker { color: var(--acc); }

  .intro .label a { color: var(--acc); text-decoration: none; }
  .intro h1 { font-family: var(--display); font-style: normal; font-weight: 600; font-size: clamp(44px, 5.6vw, 76px); line-height: 1; }
  .intro h1 .num { color: var(--acc); font-size: 0.45em; vertical-align: 0.6em; font-family: var(--mono); font-weight: 400; }
  .lede { max-width: 820px; margin: 14px 0; }
  .jump { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 8px; margin-top: 22px; }
  .jump .label { flex-basis: 100%; margin-top: 8px; }
  .jump .btn { text-decoration: none; }
  .part { font-family: var(--display); font-weight: 600; font-size: clamp(30px, 3vw, 40px); margin: 72px 0 0; padding-top: 18px; border-top: 4px double var(--rule); display: flex; gap: 16px; align-items: baseline; }
  .part span { font-style: italic; font-weight: 500; color: var(--ink-2); }
  .block { scroll-margin-top: 70px; }
</style>
