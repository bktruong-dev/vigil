---
import Base from '../layouts/Base.astro';
import data from '../data/feed.json';

type Post = { n: number; title: string; url: string; site: string; type: string; why: string; by: string; date: string; points: number; comments: number; discuss: string };
const board = (data as any).community ?? { posts: [], pending: 0 };
const posts: Post[] = board.posts ?? [];
const NEW = 'https://github.com/bktruong-dev/vigil/issues/new?template=submit.yml';
const ago = (iso: string) => {
  const h = (Date.now() - Date.parse(iso)) / 36e5;
  return h < 1 ? 'just now' : h < 24 ? `${Math.round(h)}h ago` : `${Math.round(h / 24)}d ago`;
};
---
<Base title="Community" current="/community" description="Links shared by readers, voted up by readers: AI safety news, papers, tools and discussions.">
  <div class="wrap page">
    <header class="phead">
      <div>
        <p class="label crumb"><a href="/">Front Page</a> / Section IX</p>
        <h1><span class="num">IX.</span> Community</h1>
        <p class="dek">Links shared and voted up by readers, like Hacker News for AI safety. Posts are reviewed before they appear; vote with 👍 and discuss on each post’s thread.</p>
      </div>
      <form class="submit card" id="submit-form" autocomplete="off">
        <p class="label k">Share a link</p>
        <label><span class="visually-hidden">Link</span><input type="url" name="link" placeholder="https://…" required maxlength="500" /></label>
        <label><span class="visually-hidden">Headline</span><input type="text" name="headline" placeholder="Headline" required maxlength="200" /></label>
        <button class="btn go" type="submit">Continue on GitHub →</button>
        <p class="fine">Posting uses a free GitHub account, which keeps spam out. Your link opens in a prefilled form; nothing is sent until you press Submit there.</p>
      </form>
    </header>

    {posts.length > 0 ? (
      <ol class="board">
        {posts.map((p, i) => (
          <li class="post rv">
            <span class="rank">{i + 1}.</span>
            <a class="vote" href={p.discuss} target="_blank" rel="noopener noreferrer" aria-label={`${p.points} points. Vote on GitHub with a thumbs-up`} title="Vote with 👍 on the thread">
              <svg viewBox="0 0 12 10" aria-hidden="true"><path d="M6 1l5 8H1z" /></svg><b>{p.points}</b>
            </a>
            <div class="pb">
              <p class="pt"><a class="hl" href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a> <span class="site">({p.site})</span></p>
              {p.why && <p class="why">{p.why}</p>}
              <p class="pm"><span class="tag">{p.type}</span> by {p.by} · {ago(p.date)} · <a href={p.discuss} target="_blank" rel="noopener noreferrer">{p.comments} {p.comments === 1 ? 'comment' : 'comments'}</a></p>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <div class="empty card">
        <p class="big">The board is open.</p>
        <p>No posts yet{board.pending ? ` (${board.pending} waiting for review)` : ''}. Be the first to share something worth reading about AI safety: a paper that changed your mind, a good explainer, a tool, an event or a job.</p>
        <a class="btn go" href={NEW} target="_blank" rel="noopener noreferrer">Submit a link →</a>
      </div>
    )}

    <section class="how" aria-labelledby="how-h">
      <h2 id="how-h" class="label">How the board works</h2>
      <ol>
        <li><b>Share</b> a link with the form above (it opens GitHub’s submission form, already filled in).</li>
        <li><b>Review:</b> posts are checked for relevance and spam, then labelled “approved”. Usually within a day{board.pending ? `; ${board.pending} waiting now` : ''}.</li>
        <li><b>Vote and discuss:</b> 👍 on a post’s thread is a vote; comments there are the discussion.</li>
        <li><b>Ranking</b> uses Hacker News’ formula: points ÷ (age in hours + 2)<sup>1.8</sup>, refreshed every hour, so new posts get a fair chance and old ones settle.</li>
      </ol>
    </section>
  </div>
</Base>

<script>
  // Builds the prefilled GitHub form link. Nothing is sent from this page.
  const form = document.getElementById('submit-form') as HTMLFormElement | null;
  form?.addEventListener('submit', e => {
    e.preventDefault();
    const fd = new FormData(form);
    const link = String(fd.get('link') ?? '').trim();
    const headline = String(fd.get('headline') ?? '').trim();
    try { const u = new URL(link); if (u.protocol !== 'https:' && u.protocol !== 'http:') throw 0; } catch { (form.elements.namedItem('link') as HTMLInputElement).setCustomValidity('Please enter a full link starting with https://'); form.reportValidity(); return; }
    const q = new URLSearchParams({ template: 'submit.yml', title: `[Submit] ${headline}`.slice(0, 200), link, headline });
    window.open(`https://github.com/bktruong-dev/vigil/issues/new?${q}`, '_blank', 'noopener');
  });
  form?.querySelector('input[name="link"]')?.addEventListener('input', e => (e.target as HTMLInputElement).setCustomValidity(''));
</script>

<style>
  .page { padding-top: 34px; }
  .phead { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 36px; align-items: end; border-bottom: 2px solid var(--rule); padding-bottom: 24px; margin-bottom: 26px; }
  .crumb { margin: 0 0 6px; }
  .crumb a { color: var(--acc); text-decoration: none; }
  h1 { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(48px, 6vw, 84px); line-height: 0.98; }
  h1 .num { color: var(--acc); font-size: 0.45em; vertical-align: 0.6em; font-family: var(--mono); font-weight: 400; }
  .dek { margin: 10px 0 0; font-size: 20px; color: var(--ink-2); max-width: 640px; }
  .submit { padding: 18px; display: grid; gap: 10px; }
  .submit .k { margin: 0; color: var(--gold); }
  .submit input { width: 100%; font: 15px var(--mono); color: var(--ink); background: var(--well); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; }
  .submit input:focus { outline: none; border-color: var(--acc); box-shadow: 0 0 0 3px var(--acc-glow); }
  .go { justify-self: start; color: var(--bg); background: var(--acc); border-color: var(--acc); text-decoration: none; }
  .go:hover { color: var(--bg); box-shadow: 0 0 22px -4px var(--acc-glow); }
  .fine { margin: 0; font-size: 14px; color: var(--dim); }

  .board { list-style: none; margin: 0; padding: 0; max-width: 980px; }
  .post { display: grid; grid-template-columns: 34px 52px minmax(0, 1fr); gap: 10px; align-items: start; padding: 14px 0; border-bottom: 1px solid var(--line-2); }
  .rank { font-family: var(--mono); color: var(--dim); text-align: right; padding-top: 6px; }
  .vote { display: grid; justify-items: center; gap: 2px; padding: 6px 0; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; color: var(--dim); transition: color .25s var(--ease), border-color .25s var(--ease), transform .25s var(--ease); }
  .vote svg { width: 12px; height: 10px; fill: currentColor; }
  .vote b { font-family: var(--mono); font-weight: 500; font-size: 13px; color: var(--ink); }
  .vote:hover { color: var(--acc); border-color: var(--acc); transform: translateY(-2px); }
  .pt { margin: 0; font-size: 21px; line-height: 1.3; font-weight: 520; }
  .pt a { text-decoration: none; }
  .site { font-family: var(--mono); font-size: 12px; color: var(--dim); }
  .why { margin: 4px 0 0; color: var(--ink-2); font-size: 17px; }
  .pm { margin: 6px 0 0; font-family: var(--mono); font-size: 12px; color: var(--dim); }
  .pm a { color: var(--acc); text-decoration: none; }
  .tag { color: var(--gold); text-transform: uppercase; letter-spacing: 0.08em; }
  .empty { padding: 34px; text-align: center; max-width: 760px; margin: 0 auto; }
  .empty .big { font-family: var(--display); font-weight: 600; font-size: 38px; margin: 0 0 8px; }
  .empty p { color: var(--ink-2); }
  .empty .go { display: inline-block; margin-top: 8px; }
  .how { margin-top: 56px; max-width: 820px; }
  .how ol { margin: 10px 0 0; padding-left: 22px; display: grid; gap: 8px; color: var(--ink-2); font-size: 18px; }
  .how b { color: var(--ink); font-weight: 560; }
  @media (max-width: 860px) { .phead { grid-template-columns: minmax(0, 1fr); } }
</style>
