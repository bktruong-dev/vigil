---
import Base from '../layouts/Base.astro';
import { sources, items, generated, KIND_LABEL, host, PERSPECTIVES, PERSPECTIVE_ORDER } from '../lib/feed';
import Mix from '../components/Mix.astro';
const groups = Object.entries(Object.groupBy(sources, s => s.kind)) as [keyof typeof KIND_LABEL, typeof sources][];
const placed = items.filter(i => i.place).length;
---
<Base title="Sources & method" current="/sources" compact description="Every source The Vigil reads, and exactly how stories are chosen and ranked.">
  <div class="wrap page">
    <header class="intro">
      <p class="label">§ Sources &amp; method</p>
      <h1>Where every story comes from</h1>
      <p class="lede">The Vigil doesn’t write the news. It reads {sources.length} public sources, keeps the AI safety stories, ranks them and sends you to the original. Every headline links to the site that published it, and we only show a title, a short excerpt and the publisher’s preview image. Links highlight the passage you saw here when the original page opens (in Chrome, Edge and Safari).</p>
      <p class="label">Last updated <time datetime={generated.toISOString()} data-ago>{generated.toISOString()}</time> · {items.length} stories · {placed} on the map</p>
    </header>

    <section class="block" aria-labelledby="src-h">
      <header class="sec-head"><span class="num">I.</span><h2 id="src-h">The sources</h2></header>
      {groups.map(([kind, list]) => (
        <div class="group">
          <p class="label gk">{KIND_LABEL[kind]}{kind === 'video' ? 's · YouTube channels' : kind === 'news' ? ' outlets' : 's'}</p>
          <ul class="src-list">
            {list.map(s => (
              <li class="card src">
                <div class="sn">
                  <span class={`st ${s.ok ? 'ok' : 'down'}`} title={s.ok ? 'Live' : `Unavailable: ${s.error}`}></span>
                  <a class="hl" href={s.home} target="_blank" rel="noopener noreferrer">{s.name}</a>
                </div>
                <div class="sm label">
                  <span class={`persp pc-${s.perspective}`} title={PERSPECTIVES[s.perspective].note}>{PERSPECTIVES[s.perspective].label}</span>
                  <span>{s.count} stories</span>
                  <span>Trust {Math.round(s.trust * 100)}</span>
                  <span>{s.minScore === 0 ? 'All posts' : s.minScore === 1 ? 'Safety-related posts' : 'Clear safety stories only'}</span>
                </div>
                <a class="out" href={s.feed} target="_blank" rel="noopener noreferrer"><span class="host">{s.id === 'anthropic' ? 'sitemap' : 'feed'} · {host(s.feed)}</span><span class="arrow">↗</span></a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="block" id="perspective" aria-labelledby="per-h">
      <header class="sec-head"><span class="num">I.ii</span><h2 id="per-h">Perspective: who is speaking</h2></header>
      <p class="lede small">Every story carries a perspective label, so you can see who is speaking and weigh it. An AI company writing about its own model is not the same as a reporter covering it. We don’t score outlets as “left” or “right”; we label what kind of voice each source is, which matters more for AI safety. Each page shows its perspective mix as a bar.</p>
      <dl class="plist">
        {PERSPECTIVE_ORDER.map(p => <div><dt><span class={`persp pc-${p}`}>{PERSPECTIVES[p].label}</span></dt><dd>{PERSPECTIVES[p].note}</dd></div>)}
      </dl>
      <div class="mixw"><Mix list={items} label="Today’s edition" /></div>
    </section>

    <section class="block" id="algorithm" aria-labelledby="alg-h">
      <header class="sec-head"><span class="num">II.</span><h2 id="alg-h">How stories are ranked</h2></header>
      <ol class="steps">
        <li><span class="label">Step 1 — Collect</span><p>Every two hours a script reads each source’s official public feed (RSS, Atom, the arXiv API or YouTube’s channel feeds). Anthropic has no feed, so we read its public sitemap and each post’s own title and date.</p></li>
        <li><span class="label">Step 2 — Relevance</span><p>Each story is scored against a weighted list of AI safety terms: alignment, interpretability, jailbreaks, red-teaming, evaluations, governance, misuse and more. General tech outlets must show a clear safety signal; safety-focused sources are kept whole.</p></li>
        <li><span class="label">Step 3 — Rank</span>
          <p class="formula"><span>score</span> = 0.45 × <span>relevance</span> + 0.25 × <span>source trust</span> + 0.30 × <span>freshness</span> + <span>coverage</span></p>
          <p>Freshness fades smoothly with age (it halves about every three days), so the front page turns over on its own. Coverage adds a small bonus when several outlets report the same story.</p></li>
        <li><span class="label">Step 4 — Merge</span><p>When different outlets cover the same story, they become one entry with “Also covered by” links. Multiple reports of the same incident are grouped using the AI Incident Database’s incident number.</p></li>
        <li><span class="label">Step 5 — Tone and place</span><p>A word list marks each story as a risk, good news, research or a general update. A place name in the headline (or else the company’s headquarters) puts it on the map. Both are automatic and approximate.</p></li>
      </ol>
    </section>

    <section class="block" aria-labelledby="no-h">
      <header class="sec-head"><span class="num">III.</span><h2 id="no-h">What we don’t do</h2></header>
      <ul class="nots">
        <li>No full articles. Headlines, short excerpts and a link: the original site gets the visit.</li>
        <li>No AI-written summaries. The excerpt is the publisher’s own description; topic briefs are written by hand.</li>
        <li>Images are the preview images publishers provide for sharing, loaded from their own servers and linked to the article.</li>
        <li>No tracking, cookies, ads or accounts.</li>
        <li>No paid APIs. Everything runs on free public feeds.</li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .page { padding-top: 40px; }
  .intro h1 { font-style: italic; font-weight: 500; font-size: clamp(38px, 5vw, 64px); line-height: 1.05; margin: 8px 0 14px; }
  .lede { font-size: 22px; color: var(--ink-2); max-width: 820px; margin: 0 0 14px; }
  .block { margin-top: 64px; }
  .group { margin-bottom: 28px; }
  .gk { margin: 0 0 10px; color: var(--gold); }
  .src-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 380px), 1fr)); gap: 12px; }
  .src { padding: 14px 18px; display: flex; flex-direction: column; gap: 8px; }
  .sn { display: flex; align-items: center; gap: 10px; font-size: 21px; }
  .sn a { text-decoration: none; }
  .st { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .st.ok { background: var(--good); box-shadow: 0 0 8px var(--good); }
  .st.down { background: var(--risk); box-shadow: 0 0 8px var(--risk); }
  .sm { display: flex; gap: 14px; flex-wrap: wrap; font-size: 10px; }
  .src .out { align-self: flex-start; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; counter-reset: s; max-width: 900px; }
  .steps li { border-left: 1px solid var(--line); padding: 4px 0 4px 22px; position: relative; }
  .steps li::before { content: ''; position: absolute; left: -4px; top: 9px; width: 7px; height: 7px; border-radius: 50%; background: var(--acc); box-shadow: 0 0 10px var(--acc); }
  .steps .label { color: var(--acc); }
  .steps p { margin: 6px 0 0; font-size: 19px; color: var(--ink-2); }
  .formula { font-family: var(--mono); font-size: 14px !important; background: var(--well); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; color: var(--ink) !important; overflow-x: auto; }
  .formula span { color: var(--gold); }
  .nots { margin: 0; padding-left: 20px; font-size: 19px; color: var(--ink-2); display: grid; gap: 8px; max-width: 820px; }
  .small { font-size: 19px; margin-bottom: 18px; }
  .plist { margin: 0 0 22px; display: grid; gap: 10px; max-width: 860px; }
  .plist div { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 14px; align-items: baseline; }
  .plist dd { margin: 0; color: var(--ink-2); font-size: 17.5px; }
  .mixw { max-width: 860px; }
  .intro h1 { font-family: var(--display); }
  .nots li::marker { color: var(--acc); }
</style>
